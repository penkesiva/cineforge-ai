# ---------------------------------------------------------------------------
# CineForge AI environment configuration
# Copy to .env (never commit .env). Defaults run the full demo with NO cloud
# credentials and NO paid API calls.
# ---------------------------------------------------------------------------

CINEFORGE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_demo
DEFAULT_PRODUCTION_MODE=balanced

# --- Database (Supabase CLI local stack: `supabase start`) -----------------
# Host tools use 127.0.0.1; containers reach the host via host.docker.internal.
# For Supabase Cloud later, replace with the project's connection string.
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# --- Queue -----------------------------------------------------------------
QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

# --- Media storage ---------------------------------------------------------
# local = persistent Docker volume (cineforge-media) mounted at /data/media.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/media
# Supabase Storage (Phase 1+). Leave blank for local development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cineforge-media

# --- AI providers ----------------------------------------------------------
# Docs: docs/development/providers.md
#
# Safety layers. A PAID call happens only when ALL of these are true:
#   1. PROVIDER_MODE=live            (mock = only offline mock providers, $0)
#   2. ALLOW_PAID_PROVIDERS=true     (hard switch for every paid provider)
#   3. the provider is enabled on the dashboard Sources page (paid ones start disabled)
#   4. a key exists (Sources page -> Vault, or the env var below)
#   5. the production budget can reserve the estimated cost (prices below)
# Free providers (Wikipedia, Wikimedia Commons, Openverse) need only layers 1 + 3
# and internet access. Defaults = mock + paid off: offline and free.
PROVIDER_MODE=mock
ALLOW_PAID_PROVIDERS=false
# Comma list of price catalogs (packages/configurations/pricing/<version>.yaml), merged.
# A model with no price here cannot be called (fails closed).
PRICE_CATALOG_VERSION=mock-2026-10,open-sources-2026-10,anthropic-2026-10,higgsfield-2026-10,higgsfield-2026-10b

# Where keys entered on the Sources page are stored: vault = Supabase Vault (encrypted
# in the local Supabase Postgres, shared by api + workers); memory = tests only.
# compose.yaml forces vault for the containers.
SECRETS_BACKEND=vault

# Anthropic (paid). OPTIONAL: leave empty and enter the key on the Sources page
# instead (stored encrypted in Vault, never shown again). If set, this env key wins
# over the stored key. NEVER commit a real key (make check-media fails on it).
ANTHROPIC_API_KEY=
# Must have a price entry in the anthropic-* catalog (verify prices first).
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini video (Veo). OPTIONAL: leave empty and enter the key on the Sources page.
# If set, this env key wins over the stored key. NEVER commit a real key.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Outbound HTTP for real providers. Wikimedia requires a descriptive User-Agent
# with contact info: replace the URL/email with yours if you fork the project.
HTTP_TIMEOUT_SEC=20
HTTP_USER_AGENT="CineForgeAI/0.2 (https://github.com/penkesiva/cineforge-ai)"

# Live tests (pytest -m live) are skipped unless RUN_LIVE_TESTS=1 (`make test-live`).
# Budget cap for `make demo-live` (USD).
DEMO_BUDGET_USD=1.00

# --- API / dashboard -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
