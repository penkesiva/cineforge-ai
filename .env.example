# ---------------------------------------------------------------------------
# CineForge AI environment configuration
# Copy to .env (never commit .env). Defaults run the full demo with NO cloud
# credentials and NO paid API calls.
# ---------------------------------------------------------------------------

CINEFORGE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_demo
DEFAULT_PRODUCTION_MODE=balanced

# --- Database (Supabase CLI local stack: `supabase start`) -----------------
# Host tools use 127.0.0.1; containers reach the host via host.docker.internal.
# For Supabase Cloud later, replace with the project's connection string.
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# --- Queue -----------------------------------------------------------------
QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

# --- Media storage ---------------------------------------------------------
# local = persistent Docker volume (cineforge-media) mounted at /data/media.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/media
# Supabase Storage (Phase 1+). Leave blank for local development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cineforge-media

# --- AI providers ----------------------------------------------------------
# Only mock providers exist in Phase 0. Paid providers stay disabled unless
# explicitly approved AND ALLOW_PAID_PROVIDERS=true.
PROVIDER_MODE=mock
ALLOW_PAID_PROVIDERS=false
PRICE_CATALOG_VERSION=mock-2026-10

# --- API / dashboard -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
